# Grants the logged-in seat user direct read/write access to the
# SkullSaints Agni TFT panel, so normal frame updates never need root.
# TAG+="uaccess" is the modern systemd-logind mechanism for this; MODE is
# a fallback for systems without logind seat management.
SUBSYSTEM=="usb", ATTR{idVendor}=="04d9", ATTR{idProduct}=="fd01", MODE="0666", TAG+="uaccess"
